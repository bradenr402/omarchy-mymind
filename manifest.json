{
  "schemaVersion": 1,
  "id": "bradenr402.mymind",
  "name": "mymind",
  "version": "1.0.0",
  "author": "Braden Roth",
  "license": "MIT",
  "description": "Search your mymind, and save URLs, notes and clipboard contents (text or images) to it",
  "kinds": [
    "overlay",
    "bar-widget"
  ],
  "keepLoaded": true,
  "entryPoints": {
    "overlay": "Overlay.qml",
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "mymind",
    "description": "Opens the mymind search overlay; right-click saves the clipboard",
    "category": "Productivity",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "semantic": false
    },
    "schema": [
      {
        "key": "semantic",
        "type": "boolean",
        "label": "Semantic search by default"
      }
    ]
  }
}
